# Local environments and temporary files
venvs/
.venv/
tmp/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Secrets and machine-specific settings
.env
.env.*
training/*.local.yaml
*.key
*.pem

# Model artifacts and medical imaging data
*.pth
*.pt
*.ckpt
*.nii
*.nii.gz
*.npy
*.npz

