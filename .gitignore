challenge-codebase/

# Private infrastructure notes and machine-specific runbooks
context/
**/BICMAC_SERVER_CONTEXT.md
**/*SERVER_CONTEXT*.md

# Keep only the public method specification from the experiment archive.
experiments/*
!experiments/BICMAC_V4_5_METHOD_TECHNICAL_PAPER_SOURCE.md

# Keep only the portable Docker application sources.
docker_final_v4_5/*
